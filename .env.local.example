# ============ SUPABASE ============
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ============ PAGAMENTOS ============

# Stripe (global — cartão, MBWay via PT)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenPix (Brasil — Pix)
OPENPIX_APP_ID=<app-id>
OPENPIX_WEBHOOK_SECRET=<webhook-secret>

# Asaas (Brasil — Pix, Boleto, Cartão)
ASAAS_API_KEY=<api-key>
ASAAS_WEBHOOK_TOKEN=<webhook-token>

# IfThenPay (Portugal — MBWay, Multibanco)
IFTHENPAY_MBWAY_KEY=<key>
IFTHENPAY_MULTIBANCO_ENTITY=<entity>
IFTHENPAY_ANTI_PHISHING_KEY=<key>

# MercadoPago (Brasil/PT)
MERCADOPAGO_ACCESS_TOKEN=<access-token>
MERCADOPAGO_WEBHOOK_SECRET=<webhook-secret>

# ============ PROVIDER ATIVO (padrão para novos clientes) ============
# Valores: stripe | openpix | asaas | ifthenpay | mercadopago | manual
NEXT_PUBLIC_PAYMENT_PROVIDER=openpix

# ============ APP ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
